APP_NAME=Policy Knowledge Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
SECURE_COOKIES=false
DOCUMENT_STORAGE_DIR=uploads/documents
MAX_DOCUMENT_SIZE_BYTES=10485760
CHROMA_STORAGE_DIR=chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.65
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5433/policy_assistant
