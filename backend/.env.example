APP_NAME=Policy Knowledge Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_SAMESITE=lax
SECURE_COOKIES=false
DOCUMENT_STORAGE_DIR=uploads/documents
MAX_DOCUMENT_SIZE_BYTES=10485760
CHROMA_STORAGE_DIR=chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=220
CHUNK_OVERLAP=40
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.65
RAG_MAX_CITATIONS=2
RAG_CITATION_DISTANCE_MARGIN=0.08
RAG_EXCERPT_MAX_CHARS=600
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5433/policy_assistant
